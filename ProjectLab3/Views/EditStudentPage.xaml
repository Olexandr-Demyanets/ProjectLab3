<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectLab3.Views.EditStudentPage"
             Title="Студент">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8" MaximumWidthRequest="640">

            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />

            <Label Text="ПІБ" />
            <Entry x:Name="FullNameEntry" Placeholder="Прізвище Ім'я По батькові" />

            <Label Text="Факультет" />
            <Entry x:Name="FacultyEntry" Placeholder="Наприклад: ФІТ" />

            <Label Text="Кафедра" />
            <Entry x:Name="DepartmentEntry" Placeholder="Наприклад: Програмної інженерії" />

            <Label Text="Група" />
            <Entry x:Name="GroupEntry" Placeholder="Наприклад: ПІ-21" />

            <Label Text="Курс (1–6)" />
            <Entry x:Name="CourseEntry" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="4">
                <CheckBox x:Name="BudgetCheck" />
                <Label Text="Навчається на бюджеті" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Стипендія" />
            <Picker x:Name="ScholarshipPicker" />

            <HorizontalStackLayout Spacing="4">
                <CheckBox x:Name="HeadmanCheck" />
                <Label Text="Староста групи" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Дисципліни: кожна з нового рядка у форматі «Назва: оцінка»" />
            <Editor x:Name="DisciplinesEditor" HeightRequest="150" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{AppThemeBinding Light=#C62828, Dark=#FF8A80}" />

            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                <Button Text="Зберегти" Clicked="OnSaveClicked" />
                <Button Text="Скасувати" Clicked="OnCancelClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
